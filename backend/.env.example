# template_marketplace_restaurant — backend env vars
# Copy to `.env` and fill in real values before booting the backend.
# Backend will refuse to start (KeyError / RuntimeError) if any REQUIRED var is unset.

# ─── REQUIRED ─────────────────────────────────────────────────────────────

# MongoDB connection — hard-required (os.environ[...])
MONGO_URL=mongodb://localhost:27017
DB_NAME=restaurant_db

# JWT signing secret — hard-required (os.environ[...])
# Generate one: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me-to-a-long-random-string

# Admin owner — fail-fast at seed time
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-strong-password

# ─── PAYMENTS (optional but needed for Stripe checkout) ───────────────────
STRIPE_API_KEY=

# ─── DEMO ACCOUNT (optional) ──────────────────────────────────────────────
# Powers the "one-tap demo login" on /login. Defaults to Demo123! if unset —
# scope-excluded (demo customer role, not admin). Override for production.
DEMO_EMAIL=demo@culinaryeditorial.com
DEMO_PASSWORD=Demo123!

# ─── OPTIONAL ─────────────────────────────────────────────────────────────
FRONTEND_URL=
EMERGENT_LLM_KEY=
